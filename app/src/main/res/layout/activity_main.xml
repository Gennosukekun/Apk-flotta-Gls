<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="52dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GESTIONE FLOTTA" android:textColor="#64748B" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.12" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Chiavi Mezzi" android:textColor="#172033" android:textSize="32sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Ritiro e restituzione rapida delle chiavi" android:textColor="#64748B" android:textSize="14sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/card_background" android:gravity="center_vertical" android:orientation="horizontal" android:padding="18dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AUTISTA" android:textColor="#64748B" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" />
                <TextView android:id="@+id/driver" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Autista non configurato" android:textColor="#172033" android:textSize="19sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/card_background" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CONFIGURAZIONE TELEFONO" android:textColor="#64748B" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.06" />
            <Spinner android:id="@+id/driverSpinner" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:background="@drawable/input_background" android:paddingStart="14dp" android:paddingEnd="14dp" />
            <Button android:id="@+id/saveDriver" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:backgroundTint="#172033" android:elevation="0dp" android:text="Conferma autista" android:textColor="#FFFFFF" android:textAllCaps="false" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/card_background" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STATO CHIAVE" android:textColor="#64748B" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" />
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Nessuna chiave assegnata" android:textColor="#172033" android:textSize="21sp" android:textStyle="bold" />
        </LinearLayout>

        <Button android:id="@+id/scan" android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="14dp" android:backgroundTint="#1D4ED8" android:elevation="2dp" android:gravity="center" android:lineSpacingExtra="5dp" android:text="▣\nSCANSIONA QR\nRitiro e restituzione chiave" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
        <Button android:id="@+id/photo" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:backgroundTint="#EFF6FF" android:elevation="0dp" android:text="Fotografa stato mezzo" android:textAllCaps="false" android:textColor="#1D4ED8" android:textStyle="bold" android:visibility="gone" />
        <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/message_background" android:gravity="center" android:minHeight="42dp" android:padding="10dp" android:textColor="#172033" android:textSize="14sp" android:textStyle="bold" />
        <Button android:id="@+id/changeDriver" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="14dp" android:backgroundTint="#E2E8F0" android:elevation="0dp" android:text="Area responsabile / Cambio autista" android:textAllCaps="false" android:textColor="#475569" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>